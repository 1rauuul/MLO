# Contenido remoto opcional (sin secretos).
# - DATA_MODE: `local` (por defecto, sin red) o `hybrid` (consulta el contenido publicado).
# - API_URL: base del contrato v2, por ejemplo https://<host>/api/mlo/v2
# Expo solo expone al cliente las variables con prefijo EXPO_PUBLIC_.
# En builds de EAS, `.env` no se sube: define las dos variables en el `env`
# del perfil `preview` de `eas.json` o en las variables del proyecto.
EXPO_PUBLIC_DATA_MODE=hybrid
EXPO_PUBLIC_API_URL=http://<host>:3000/api/mlo/v2

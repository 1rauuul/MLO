import type { SQLiteDatabase } from 'expo-sqlite';

import type { ActivityType, Attempt } from '@/shared/model/entities';

interface AttemptRow {
  id: number;
  account_id: number;
  source: string;
  item_id: string;
  item_type: ActivityType;
  lesson_id: string;
  correct: number;
  created_at: string;
}

function mapAttempt(row: AttemptRow): Attempt {
  return {
    id: row.id,
    accountId: row.account_id,
    source: row.source === 'evaluation' ? 'evaluation' : 'practice',
    itemId: row.item_id,
    itemType: row.item_type,
    lessonId: row.lesson_id,
    correct: row.correct === 1,
    createdAt: row.created_at,
  };
}

export async function insertAttempt(
  db: SQLiteDatabase,
  accountId: number,
  source: 'practice' | 'evaluation',
  itemId: string,
  itemType: ActivityType,
  lessonId: string,
  correct: boolean,
): Promise<void> {
  await db.runAsync(
    'INSERT INTO attempts (account_id, source, item_id, item_type, lesson_id, correct, created_at) VALUES (?, ?, ?, ?, ?, ?, ?)',
    accountId,
    source,
    itemId,
    itemType,
    lessonId,
    correct ? 1 : 0,
    new Date().toISOString(),
  );
}

export async function selectAttemptsByLesson(
  db: SQLiteDatabase,
  accountId: number,
  lessonId: string,
): Promise<Attempt[]> {
  const rows = await db.getAllAsync<AttemptRow>(
    'SELECT * FROM attempts WHERE account_id = ? AND lesson_id = ? ORDER BY id',
    accountId,
    lessonId,
  );
  return rows.map(mapAttempt);
}
</file>

<file path="src/features/exercises/model/exerciseRepository.ts">
import type { SQLiteDatabase } from 'expo-sqlite';

import type { Exercise, ExerciseConfig, ExerciseType } from '@/shared/model/entities';

interface ExerciseRow {
  id: string;
  lesson_id: string;
  type: ExerciseType;
  prompt: string;
  instructions: string;
  correct_order: string;
  config: string;
  explanation: string;
}

function mapExercise(row: ExerciseRow): Exercise {
  let correctOrder: string[] = [];
  try {
    const parsed: unknown = JSON.parse(row.correct_order);
    if (Array.isArray(parsed)) {
      correctOrder = parsed.filter((item): item is string => typeof item === 'string');
    }
  } catch {
    correctOrder = [];
  }
  let config: ExerciseConfig = {};
  try {
    const parsedConfig: unknown = JSON.parse(row.config ?? '{}');
    if (parsedConfig && typeof parsedConfig === 'object') {
      config = parsedConfig as ExerciseConfig;
    }
  } catch {
    config = {};
  }
  return {
    id: row.id,
    lessonId: row.lesson_id,
    type: row.type,
    prompt: row.prompt,
    instructions: row.instructions,
    correctOrder,
    config,
    explanation: row.explanation ?? '',
  };
}

export async function selectExercisesByLesson(db: SQLiteDatabase, lessonId: string): Promise<Exercise[]> {
  const rows = await db.getAllAsync<ExerciseRow>(
    'SELECT * FROM exercises WHERE lesson_id = ? ORDER BY rowid',
    lessonId,
  );
  return rows.map(mapExercise);
}

<file path="src/features/evaluations/viewmodel/analytics.logic.ts">
import type { Attempt } from '@/shared/model/entities';
import { ACTIVITY_TYPES } from '@/shared/model/entities';

export interface AttemptSummary {
  total: number;
  correct: number;
  accuracy: number;
  byType: Record<string, { total: number; correct: number }>;
  byTopic?: Record<string, { total: number; correct: number }>;
}

export function summarizeAttempts(
  attempts: Attempt[],
  topicById: Record<string, string> = {},
): AttemptSummary {
  const byType: AttemptSummary['byType'] = {};
  const byTopic: AttemptSummary['byTopic'] = {};
  let correct = 0;
  let total = 0;
  for (const attempt of attempts) {
    if (!ACTIVITY_TYPES.includes(attempt.itemType)) {
      continue;
    }
    const bucket = byType[attempt.itemType] ?? { total: 0, correct: 0 };
    bucket.total += 1;
    total += 1;
    if (attempt.correct) {
      bucket.correct += 1;
      correct += 1;
    }
    byType[attempt.itemType] = bucket;

    const topic = topicById[attempt.itemId];
    if (topic) {
      const topicBucket = byTopic[topic] ?? { total: 0, correct: 0 };
      topicBucket.total += 1;
      if (attempt.correct) {
        topicBucket.correct += 1;
      }
      byTopic[topic] = topicBucket;
    }
  }
  return { total, correct, accuracy: total === 0 ? 1 : correct / total, byType, byTopic };
}

export function weakTypes(summary: AttemptSummary, threshold = 3): string[] {
  return Object.entries(summary.byType)
    .filter(([, bucket]) => bucket.total - bucket.correct >= threshold)
    .map(([type]) => type);
}

export function weakTopics(summary: AttemptSummary, threshold = 2): string[] {
  return Object.entries(summary.byTopic ?? {})
    .filter(([, bucket]) => bucket.total - bucket.correct >= threshold)
    .map(([topic]) => topic);
}

export function recommendReview(
  summary: AttemptSummary,
  accuracyThreshold = 0.6,
): 'lesson' | 'practice' | 'none' {
  if (summary.total === 0) {
    return 'none';
  }
  if (summary.accuracy < accuracyThreshold) {
    return 'lesson';
  }
  if (weakTypes(summary).length > 0) {
    return 'practice';
  }
  return 'none';
}
</file>

<file path="src/features/evaluations/viewmodel/evaluation.logic.ts">
import type { Question } from '@/shared/model/entities';

import {
  crosswordCells,
  isCrosswordCorrect,
  isFillCorrect,
  isMatchCorrect,
  isOrderCorrect,
  shuffleItems,
} from '@/features/exercises/viewmodel/exercise.logic';

export type EvaluationAnswer =
  | { type: 'mcq'; chosen: number }
  | { type: 'order'; steps: string[] }
  | { type: 'fill'; ordered: string[]; assignment: (string | null)[] }
  | { type: 'match'; rights: string[]; assignment: (number | null)[] }
  | { type: 'crossword'; letters: Record<string, string> };

export function isAnswerComplete(question: Question, answer: EvaluationAnswer | null): boolean {
  if (!answer || answer.type !== question.type) {
    return false;
  }
  switch (answer.type) {
    case 'mcq':
    case 'order':
      return true;
    case 'fill':
      return answer.assignment.length > 0 && answer.assignment.every(item => item !== null);
    case 'match':
      return answer.assignment.length > 0 && answer.assignment.every(item => item !== null);
    case 'crossword': {
      const cells = crosswordCells(question.config);
      return (
        cells.length > 0 &&
        cells.every(cell => (answer.letters[`${cell.row}-${cell.col}`] ?? '') !== '')
      );
    }
  }
}

export function isAnswerCorrect(question: Question, answer: EvaluationAnswer): boolean {
  switch (answer.type) {
    case 'mcq':
      return answer.chosen === question.answer;
    case 'order':
      return isOrderCorrect(answer.steps, question.options);
    case 'fill':
      return isFillCorrect(answer.ordered, answer.assignment);
    case 'match':
      return isMatchCorrect(question.config.pairs ?? [], answer.rights, answer.assignment);
    case 'crossword':
      return isCrosswordCorrect(question.config, answer.letters);
  }
}

// Baraja las opciones de una pregunta mcq y reajusta el índice correcto,
// para que el alumno no memorice la posición de la respuesta.
export function shuffleQuestionOptions(
  question: Question,
  random: () => number = Math.random,
): Question {
  if (question.type !== 'mcq' || question.options.length < 2) {
    return question;
  }
  const indexed = question.options.map((option, index) => ({ option, index }));
  const shuffled = shuffleItems(indexed, random);
  return {
    ...question,
    options: shuffled.map(item => item.option),
    answer: shuffled.findIndex(item => item.index === question.answer),
  };
}

export const EVALUATION_QUESTIONS_COUNT = 10;
export const EVALUATION_EXERCISES_COUNT = 5;

export interface EvaluationPool {
  questions: Question[];
  exercises: Question[];
  mixed: Question[];
}

// Arma el pool de la evaluación: 10 preguntas + 5 ejercicios, mezclados y
// con las opciones de cada mcq barajadas.
export function buildEvaluationPool(
  questionPool: Question[],
  exercisePool: Question[],
  random: () => number = Math.random,
): EvaluationPool {
  const questions = shuffleItems(questionPool, random).slice(0, EVALUATION_QUESTIONS_COUNT);
  const exercises = shuffleItems(exercisePool, random).slice(0, EVALUATION_EXERCISES_COUNT);
  const mixed = shuffleItems([...questions, ...exercises], random).map(question =>
    shuffleQuestionOptions(question, random),
  );
  return { questions, exercises, mixed };
}
</file>


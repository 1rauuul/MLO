} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';

import { useTheme } from '@/shared/theme/ThemeProvider';

interface ScreenProps {
  children: ReactNode;
  scroll?: boolean;
  contentStyle?: StyleProp<ViewStyle>;
  edges?: ('top' | 'bottom' | 'left' | 'right')[];
  keyboardAvoiding?: boolean;
}

export function Screen({
  children,
  scroll = true,
  contentStyle,
  edges = ['top'],
  keyboardAvoiding = false,
}: ScreenProps) {
  const { colors, spacing } = useTheme();
  const padding: StyleProp<ViewStyle> = [
    { paddingHorizontal: spacing.xl, paddingTop: spacing.lg, paddingBottom: spacing.xxl },
    contentStyle,
  ];

  const content = scroll ? (
        <ScrollView
          contentContainerStyle={padding}
          showsVerticalScrollIndicator={false}
          keyboardShouldPersistTaps="handled">
          {children}
        </ScrollView>
      ) : (
        <View style={[styles.flex, padding]}>{children}</View>
      );

  return (
    <SafeAreaView style={[styles.flex, { backgroundColor: colors.bg }]} edges={edges}>
      {keyboardAvoiding ? (
        <KeyboardAvoidingView
          style={styles.flex}
          behavior={Platform.OS === 'ios' ? 'padding' : undefined}>
          {content}
        </KeyboardAvoidingView>
      ) : (
        content
      )}
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  flex: { flex: 1 },
});
</file>

<file path="src/shared/components/TextField.tsx">
import { forwardRef, useState, type ReactNode } from 'react';
import { StyleSheet, TextInput, View, type TextInputProps } from 'react-native';

import { useTheme } from '@/shared/theme/ThemeProvider';

import { AppText } from '@/shared/components/AppText';

interface TextFieldProps extends TextInputProps {
  label: string;
  error?: string;
  trailing?: ReactNode;
}

export const TextField = forwardRef<TextInput, TextFieldProps>(function TextField(
  { label, error, trailing, style, onFocus, onBlur, ...rest },
  ref,
) {
  const { colors, radius, scale } = useTheme();
  const [focused, setFocused] = useState(false);

  return (
    <View style={styles.field}>
      <AppText
        variant="eyebrow"
        color={colors.muted}
        style={{ fontSize: 12 * scale, lineHeight: 16 * scale }}>
        {label}
      </AppText>
      <View
        style={[
          styles.inputShell,
          {
            backgroundColor: colors.card,
            borderColor: error ? colors.danger : focused ? colors.primary : colors.line,
            borderRadius: radius.control,
          },
        ]}>
        <TextInput
          {...rest}
          ref={ref}
          accessibilityLabel={`${label}${error ? `, ${error}` : ''}`}
          placeholderTextColor={colors.muted}
          onFocus={event => {
            setFocused(true);
            onFocus?.(event);
          }}
          onBlur={event => {
            setFocused(false);
            onBlur?.(event);
          }}
          style={[
            styles.input,
            {
              color: colors.text,
              fontSize: 15 * scale,
            },
            style,
          ]}
        />
        {trailing}
      </View>
      {error ? (
        <AppText variant="small" color={colors.danger} accessibilityLiveRegion="polite">
          {error}
        </AppText>
      ) : null}
    </View>
  );
});

TextField.displayName = 'TextField';

const styles = StyleSheet.create({
  field: { gap: 6 },
  inputShell: {
    minHeight: 48,
    flexDirection: 'row',
    alignItems: 'center',
    borderWidth: 1,
  },
  input: { flex: 1, paddingHorizontal: 14, paddingVertical: 10, minHeight: 46 },
});
</file>


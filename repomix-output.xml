  lesson: [
    { kind: 'path', d: 'M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5z' },
    { kind: 'path', d: 'M14 2v5h5' },
    { kind: 'path', d: 'M9 12h6' },

          { lesson_id: 'l1.2', completed: 0 },
        ]),
      });

      const map = await selectProgressMap(db, 7);

      expect(map).toEqual({ 'l1.1': true, 'l1.2': false });
      expect(calls.getAllAsync).toHaveBeenCalledWith(

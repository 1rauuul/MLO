function makeDb(overrides: Partial<Calls> = {}) {
  const calls: Calls = {
    runAsync: jest.fn(async () => ({ changes: 1, lastInsertRowId: 42 })),
    getFirstAsync: jest.fn(async () => null),
    ...overrides,
  };
  return { db: calls as unknown as SQLiteDatabase, calls };
}

const accountRow = {
  id: 7,
  username: 'valentina',

  historyItem: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 12,
    padding: 14,
    borderWidth: 1,
  },
  historyMark: {
    width: 36,
    height: 36,
    borderRadius: 12,
    alignItems: 'center',

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Mapa visual de navegacion de MLO Ingenieria de Software">
  <title>Mapa de navegación | MLO</title>
  <style>
    :root {
      --ink: #102f45;
      --muted: #647887;
      --line: #8d9ba4;
      --paper: #f4f6f7;
      --white: #ffffff;
      --root: #0a3c59;
      --yellow: #f4aa1e;
      --yellow-line: #d68f12;
      --orange: #ea7223;
      --teal: #35bcc8;
      --blue: #0d8bc6;
      --red: #d64a59;
      --shadow: 0 24px 60px rgba(16, 47, 69, 0.12);
    }

    * { box-sizing: border-box; }

    html { min-width: 320px; background: var(--paper); }

    body {
      margin: 0;
      color: var(--ink);
      background:
        radial-gradient(circle at 8% 0%, rgba(53, 188, 200, 0.13), transparent 30rem),
        linear-gradient(135deg, #f8fafb 0%, var(--paper) 55%, #eef3f5 100%);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .page {
      width: min(1540px, calc(100% - 40px));
      margin: 0 auto;
      padding: 44px 0 56px;
    }

    .masthead {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 28px;
      margin-bottom: 26px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin: 0 0 12px;
      color: var(--teal);
      font-size: 0.74rem;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      width: 24px;
      height: 3px;
      border-radius: 99px;
      background: var(--teal);
      content: "";
    }

    h1 {
      max-width: 720px;
      margin: 0;
      color: var(--root);
      font-size: clamp(2.15rem, 4vw, 4.4rem);
      line-height: 0.98;
      letter-spacing: -0.06em;
    }

    .intro {
      max-width: 620px;
      margin: 16px 0 0;
      color: var(--muted);
      font-size: 1rem;
      line-height: 1.6;
    }

    .meta {
      display: grid;
      gap: 8px;
      min-width: 220px;
      padding: 18px 20px;
      border: 1px solid rgba(10, 60, 89, 0.1);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.66);
      box-shadow: 0 12px 30px rgba(16, 47, 69, 0.06);
    }

    .meta strong { font-size: 0.95rem; }
    .meta span { color: var(--muted); font-size: 0.8rem; }

    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 18px;
      margin: 0 0 18px;
      padding: 0 2px;
      color: var(--muted);
      font-size: 0.8rem;
    }

    .legend-item {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .legend-dot {
      width: 12px;
      height: 12px;
      border-radius: 4px;
      box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
    }

    .legend-dot.root { background: var(--root); }
    .legend-dot.public { background: var(--orange); }
    .legend-dot.topic { background: var(--yellow); }
    .legend-dot.resource { background: var(--teal); }
    .legend-dot.quiz { background: var(--blue); }
    .legend-dot.feedback { background: var(--red); }

    .diagram-card {
      overflow: hidden;
      border: 1px solid rgba(10, 60, 89, 0.12);
      border-radius: 28px;
      background: rgba(255, 255, 255, 0.8);
      box-shadow: var(--shadow);
    }

    .card-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 16px 22px;
      border-bottom: 1px solid rgba(10, 60, 89, 0.1);
      background: rgba(255, 255, 255, 0.68);
    }

    .card-bar p {
      margin: 0;
      color: var(--muted);
      font-size: 0.82rem;
    }

    .tools { display: flex; gap: 7px; }

    .tool {
      width: 34px;
      height: 34px;
      border: 1px solid rgba(10, 60, 89, 0.14);
      border-radius: 10px;
      color: var(--root);
      background: var(--white);
      font: inherit;
      font-weight: 800;
      cursor: pointer;
    }

    .tool:hover,
    .tool:focus-visible {
      border-color: var(--teal);
      outline: 3px solid rgba(53, 188, 200, 0.2);
      outline-offset: 1px;
    }

    .map-viewport {
      overflow: auto;
      padding: 20px;
      background:
        linear-gradient(rgba(10, 60, 89, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(10, 60, 89, 0.035) 1px, transparent 1px),
        #fbfcfc;
      background-size: 24px 24px;
      overscroll-behavior: contain;
    }

    .map-stage {
      width: 1440px;
      min-height: 1120px;
      transform-origin: top left;
      transition: transform 180ms ease;
    }

    svg {
      display: block;
      width: 1440px;
      height: 1120px;
      overflow: visible;
    }

    .boundary {
      fill: rgba(234, 230, 231, 0.45);
      stroke: rgba(10, 60, 89, 0.15);
      stroke-width: 2;
      stroke-dasharray: 10 9;
    }

    .boundary-label {
      fill: var(--muted);
      font-size: 17px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .edge {
      fill: none;
      stroke: var(--line);
      stroke-width: 2.5;
      marker-end: url(#arrow);
    }

    .edge.dashed { stroke-dasharray: 8 8; }

    .edge-label {
      fill: #617481;
      font-size: 14px;
      font-weight: 700;
    }

    .node {
      cursor: default;
      filter: drop-shadow(0 8px 8px rgba(16, 47, 69, 0.1));
    }

    .node rect {
      stroke-width: 2;
      transition: transform 150ms ease, filter 150ms ease;
    }

    .node:hover rect { filter: brightness(1.05); transform: translateY(-2px); }

    .node-title {
      fill: #fff;
      font-size: 20px;
      font-weight: 800;
      text-anchor: middle;
    }

    .node-route {
      fill: rgba(255, 255, 255, 0.88);
      font-size: 15px;
      font-weight: 600;
      text-anchor: middle;
    }

    .node.small .node-title { font-size: 17px; }
    .node.small .node-route { font-size: 13px; }

    .node.root rect { fill: var(--root); stroke: var(--root); }
    .node.public rect { fill: var(--orange); stroke: var(--orange); }
    .node.topic rect { fill: var(--yellow); stroke: var(--yellow-line); }
    .node.resource rect { fill: var(--teal); stroke: var(--teal); }
    .node.quiz rect { fill: var(--blue); stroke: var(--blue); }
    .node.feedback rect { fill: var(--red); stroke: var(--red); }

    .footnote {
      display: flex;
      justify-content: space-between;
      gap: 18px;
      margin: 16px 4px 0;
      color: var(--muted);
      font-size: 0.78rem;
      line-height: 1.5;
    }

    .footnote strong { color: var(--ink); }

    @media (max-width: 760px) {
      .page { width: min(100% - 24px, 1540px); padding-top: 26px; }
      .masthead { display: block; }
      .meta { margin-top: 22px; }
      .diagram-card { border-radius: 20px; }
      .card-bar { align-items: flex-start; }
      .footnote { display: block; }
      .footnote span { display: block; margin-bottom: 6px; }
    }
  </style>
</head>
<body>
  <main class="page">
    <header class="masthead">
      <div>
        <p class="eyebrow">MLO / Ingeniería de Software</p>
        <h1>Mapa de navegación</h1>
        <p class="intro">Flujo completo de acceso, aprendizaje y evaluación de la aplicación offline-first.</p>
      </div>
      <aside class="meta" aria-label="Información del mapa">

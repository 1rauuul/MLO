import { Pressable, StyleSheet, View } from 'react-native';

import type { Lesson } from '@/shared/model/entities';
import { useReducedMotion } from '@/shared/hooks/useReducedMotion';
import { useTheme } from '@/shared/theme/ThemeProvider';

import { AppText } from '@/shared/components/AppText';
import { Chevron } from '@/shared/components/Chevron';
import { Icon } from '@/shared/components/Icon';

interface SubtopicRowProps {
  lesson: Lesson;
  completed: boolean;
  onPress: () => void;
  inline?: boolean;
}

export function SubtopicRow({ lesson, completed, onPress, inline = false }: SubtopicRowProps) {
  const { colors, radius } = useTheme();
  const reduced = useReducedMotion();
  const accent = completed ? colors.success : colors.primary;

  return (
    <Pressable
      accessibilityRole="button"
      accessibilityLabel={`${lesson.code} ${lesson.title}${completed ? ', completado' : ''}`}
      onPress={onPress}
      style={({ pressed }) => [
        inline
          ? styles.inlineRow
          : [
              styles.row,
              {
                backgroundColor: colors.card,
                borderColor: completed ? colors.success : colors.line,
                borderRadius: radius.card,
              },
            ],
        pressed && !reduced ? (inline ? { opacity: 0.65 } : { transform: [{ scale: 0.99 }] }) : null,
      ]}>
      <View style={[styles.code, { backgroundColor: colors.soft, borderRadius: radius.control }]}>
        <AppText variant="code" color={accent}>
          {lesson.code}
        </AppText>
      </View>
      <AppText style={styles.title} weight="600">
        {lesson.title}
      </AppText>
      {completed ? (
        <Icon name="check" size={17} color={colors.success} strokeWidth={2.5} />
      ) : (
        <Chevron direction="right" size={16} color={colors.muted} strokeWidth={2.2} />
      )}
    </Pressable>
  );
}

const styles = StyleSheet.create({
  row: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 13,
    padding: 15,
    borderWidth: 1,
  },
  inlineRow: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 13,
    paddingVertical: 12,
  },
  code: {
    width: 44,
    height: 34,
    alignItems: 'center',
    justifyContent: 'center',
  },
  title: {
    flex: 1,
    fontSize: 14,
  },
});
</file>

<file path="src/features/modules/view/SubtopicTabBar.tsx">
import { Pressable, StyleSheet, View } from 'react-native';

import { useTheme } from '@/shared/theme/ThemeProvider';

import { AppText } from '@/shared/components/AppText';
import { Icon, type IconName } from '@/shared/components/Icon';

type SubtopicTab = 'inicio' | 'tema';

interface SubtopicTabBarProps {
  active: SubtopicTab | null;
  onInicio: () => void;
  onTema?: () => void;
  bottomInset?: number;
}

const items: { id: SubtopicTab; icon: IconName; label: string }[] = [
  { id: 'inicio', icon: 'home', label: 'Inicio' },
  { id: 'tema', icon: 'tile', label: 'Tema' },
];

export function SubtopicTabBar({
  active,
  onInicio,
  onTema,
  bottomInset = 0,
}: SubtopicTabBarProps) {
  const { colors } = useTheme();
  const handlers: Record<SubtopicTab, (() => void) | undefined> = {
    inicio: onInicio,
    tema: onTema,
  };
  const visibleTabs = onTema ? items : items.filter(item => item.id !== 'tema');

  return (
    <View
      accessibilityRole="tablist"
      style={[
        styles.bar,
        {
          backgroundColor: colors.surface,
          borderTopColor: colors.line,
          paddingBottom: Math.max(bottomInset, 6),
        },
      ]}>
      {visibleTabs.map(tab => {
        const isActive = active === tab.id;
        return (
          <Pressable
            key={tab.id}
            accessibilityRole="tab"
            accessibilityState={{ selected: isActive }}
            accessibilityLabel={tab.label}
            onPress={handlers[tab.id]}
            style={styles.tab}>
            <View
              style={[
                styles.iconPill,
                { backgroundColor: isActive ? `${colors.primary}2E` : 'transparent' },
              ]}>
              <Icon
                name={tab.icon}
                size={18}
                color={isActive ? colors.primary : colors.muted}
              />
            </View>
            <AppText
              variant="small"
              color={isActive ? colors.primary : colors.muted}
              weight={isActive ? '700' : '500'}>
              {tab.label}
            </AppText>
          </Pressable>
        );
      })}
    </View>
  );
}

const styles = StyleSheet.create({
  bar: {
    flexDirection: 'row',
    borderTopWidth: 1,
    paddingVertical: 6,
  },
  tab: {
    flex: 1,
    minHeight: 44,
    alignItems: 'center',
    justifyContent: 'center',
    gap: 1,
  },
  iconPill: {
    width: 44,
    height: 28,
    borderRadius: 999,
    alignItems: 'center',
    justifyContent: 'center',
  },
});
</file>


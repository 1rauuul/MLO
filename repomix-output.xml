<file path="src/features/profile/viewmodel/useLearnerProfile.tsx">
import { useSQLiteContext } from 'expo-sqlite';
import {
  createContext,
  useCallback,
  useContext,
  useEffect,
  useMemo,
  useRef,
  useState,
  type ReactNode,
} from 'react';

import { saveProfile, selectProfile } from '@/features/profile/model/profileRepository';
import type { LearnerProfile, LearningStyle } from '@/shared/model/entities';

import { useAuth } from '@/features/auth/viewmodel/useAuth';

interface LearnerProfileContextValue {
  profile: LearnerProfile | null;
  isLoading: boolean;
  style: LearningStyle;
  darkMode: boolean;
  largeText: boolean;
  setStyle: (style: LearningStyle) => void;
  setDarkMode: (value: boolean) => void;
  setLargeText: (value: boolean) => void;
  saveQuestionnaire: (style: LearningStyle) => void;
}

const FALLBACK_STYLE: LearningStyle = 'Pragmático';
const LearnerProfileContext = createContext<LearnerProfileContextValue | null>(null);

export function LearnerProfileProvider({ children }: { children: ReactNode }) {
  const db = useSQLiteContext();
  const { account } = useAuth();
  const [profile, setProfile] = useState<LearnerProfile | null>(null);
  const [isLoading, setIsLoading] = useState(true);
  const profileRef = useRef<LearnerProfile | null>(null);

  useEffect(() => {
    let active = true;
    if (!account) {
      profileRef.current = null;
      setProfile(null);
      setIsLoading(false);
      return () => {
        active = false;
      };
    }
    (async () => {
      const loaded = await selectProfile(db, account.id);
      if (!active) {
        return;
      }
      profileRef.current = loaded;
      setProfile(loaded);
      setIsLoading(false);
    })();
    return () => {
      active = false;
    };
  }, [db, account]);

  const update = useCallback(
    (changes: Partial<LearnerProfile>) => {
      const current = profileRef.current;
      if (!current) {
        return;
      }
      const next = { ...current, ...changes };
      profileRef.current = next;
      setProfile(next);
      void saveProfile(db, next);
    },
    [db],
  );

  const setStyle = useCallback((style: LearningStyle) => update({ learningStyle: style }), [update]);
  const setDarkMode = useCallback((darkMode: boolean) => update({ darkMode }), [update]);
  const setLargeText = useCallback((largeText: boolean) => update({ largeText }), [update]);

  const value = useMemo<LearnerProfileContextValue>(
    () => ({
      profile,
      isLoading,
      style: profile?.learningStyle ?? FALLBACK_STYLE,
      darkMode: profile?.darkMode ?? true,
      largeText: profile?.largeText ?? false,
      setStyle,
      setDarkMode,
      setLargeText,
      saveQuestionnaire: setStyle,
    }),
    [profile, isLoading, setStyle, setDarkMode, setLargeText],
  );

  return <LearnerProfileContext.Provider value={value}>{children}</LearnerProfileContext.Provider>;
}

export function useLearnerProfile(): LearnerProfileContextValue {
  const context = useContext(LearnerProfileContext);
  if (!context) {
    throw new Error('useLearnerProfile debe usarse dentro de LearnerProfileProvider');
  }
  return context;
}
</file>

<file path="src/features/profile/viewmodel/useProgressBackup.tsx">
import { File, Paths } from 'expo-file-system';
import * as Sharing from 'expo-sharing';
import { useSQLiteContext } from 'expo-sqlite';
import { useCallback, useState } from 'react';

import { replaceProgressFromBackup, selectProgressBackup } from '@/features/profile/model/backupRepository';
import { parseProgressBackup } from '@/features/profile/model/backup.logic';
import { useAuth } from '@/features/auth/viewmodel/useAuth';

export function useProgressBackup() {
  const db = useSQLiteContext();
  const { account } = useAuth();
  const [isBusy, setIsBusy] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [message, setMessage] = useState<string | null>(null);

  const exportProgress = useCallback(async () => {
    if (!account) {
      return;
    }
    setIsBusy(true);
    setError(null);
    setMessage(null);
    try {
      const backup = await selectProgressBackup(db, account.id);
      const file = new File(Paths.cache, `mlo-progreso-${account.id}.json`);
      if (file.exists) {
        file.delete();
      }
      file.create({ overwrite: true });
      file.write(JSON.stringify(backup, null, 2));
      if (!(await Sharing.isAvailableAsync())) {
        throw new Error('Compartir archivos no está disponible en este dispositivo.');
      }
      await Sharing.shareAsync(file.uri, {
        dialogTitle: 'Exportar progreso',
        mimeType: 'application/json',
      });
      setMessage('Respaldo listo para compartir.');
    } catch (caught) {
      setError(caught instanceof Error ? caught.message : 'No se pudo exportar el progreso.');
    } finally {
      setIsBusy(false);
    }
  }, [account, db]);

  const importProgress = useCallback(async () => {
    if (!account) {
      return false;
    }
    setIsBusy(true);
    setError(null);
    setMessage(null);
    try {
      const picked = await File.pickFileAsync({ multipleFiles: false, mimeTypes: ['application/json'] });
      if (picked.canceled) {
        return false;
      }
      const backup = parseProgressBackup(await picked.result.text());
      await replaceProgressFromBackup(db, account.id, backup);
      setMessage('Progreso importado correctamente.');
      return true;
    } catch (caught) {
      setError(caught instanceof Error ? caught.message : 'No se pudo importar el progreso.');
      return false;
    } finally {
      setIsBusy(false);
    }
  }, [account, db]);

  return { exportProgress, importProgress, isBusy, error, message };
}
</file>


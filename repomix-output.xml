    rerender({ lessonId: 'lesson-2' });

    await waitFor(() => expect(result.current.index).toBe(0));
    expect(result.current.current?.id).toBe('e9');
    expect(result.current.total).toBe(1);
    expect(result.current.isLast).toBe(true);
  });

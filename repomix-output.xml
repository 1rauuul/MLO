    (() => {
      const stage = document.getElementById('mapStage');
      const viewport = document.getElementById('mapViewport');
      const controls = document.querySelectorAll('[data-zoom]');
      let scale = 1;

      const applyScale = () => {
        stage.style.transform = `scale(${scale})`;
        stage.style.height = `${1120 * scale}px`;
        stage.style.width = `${1440 * scale}px`;
      };

      controls.forEach((control) => {
        control.addEventListener('click', () => {
          const action = control.dataset.zoom;
          if (action === 'in') scale = Math.min(1.35, +(scale + 0.1).toFixed(2));
          if (action === 'out') scale = Math.max(0.7, +(scale - 0.1).toFixed(2));
          if (action === 'reset') scale = 1;
          applyScale();
          viewport.focus({ preventScroll: true });
        });
      });

      applyScale();
    })();
  </script>

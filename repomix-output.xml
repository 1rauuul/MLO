    { kind: 'path', d: 'M21 13v1a4 4 0 0 1-4 4H3' },
  ],
  exercises: [
    { kind: 'path', d: 'M9 6h11' },
    { kind: 'path', d: 'M9 12h11' },
    { kind: 'path', d: 'M9 18h11' },
    { kind: 'path', d: 'M4.5 5l1.5 1.5 2.5-3' },
    { kind: 'path', d: 'M4.5 11l1.5 1.5 2.5-3' },
    { kind: 'path', d: 'M4.5 17l1.5 1.5 2.5-3' },
  ],
  eval: [
    { kind: 'circle', cx: 12, cy: 12, r: 9 },
    { kind: 'path', d: 'M8.5 12.5l2.5 2.5 4.5-5.5' },
  ],
  user: [
    { kind: 'circle', cx: 12, cy: 8.5, r: 3.5 },
    { kind: 'path', d: 'M4.5 19.5a7.5 7.5 0 0 1 15 0' },
  ],
  clock: [
    { kind: 'circle', cx: 12, cy: 12, r: 9 },
    { kind: 'path', d: 'M12 6.5V12l3.5 2' },
  ],
  eye: [
    { kind: 'path', d: 'M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z' },
    { kind: 'circle', cx: 12, cy: 12, r: 2.5 },
  ],
  'eye-off': [
    { kind: 'path', d: 'M3 3l18 18' },
    { kind: 'path', d: 'M10.6 6.2A10.7 10.7 0 0 1 12 6c6 0 9.5 6 9.5 6a17 17 0 0 1-3.1 3.7' },
    { kind: 'path', d: 'M6.1 6.1A17 17 0 0 0 2.5 12s3.5 6 9.5 6a10.7 10.7 0 0 0 2-.2' },
  ],
  info: [
    { kind: 'circle', cx: 12, cy: 12, r: 9 },
    { kind: 'path', d: 'M12 11v5' },
    { kind: 'path', d: 'M12 8h.01' },
  ],
  circle: [{ kind: 'circle', cx: 12, cy: 12, r: 8 }],
};

interface IconProps {
  name: IconName;
  size?: number;
  color: string;
  strokeWidth?: number;
}

export function Icon({ name, size = 20, color, strokeWidth = 2 }: IconProps) {
  const children = DEFS[name].map((config, index) => {
    const stroke = color;
    if (config.kind === 'path') {
      return (
        <Path
          key={index}
          d={config.d}
          fill="none"
          stroke={stroke}
          strokeWidth={strokeWidth}
          strokeLinecap="round"
          strokeLinejoin="round"
        />
      );
    }
    if (config.kind === 'circle') {
      return (
        <Circle
          key={index}
          cx={config.cx}
          cy={config.cy}
          r={config.r}
          fill={config.fill ? color : 'none'}
          stroke={stroke}
          strokeWidth={strokeWidth}
        />
      );
    }
    return (
      <Rect
        key={index}
        x={config.x}
        y={config.y}
        width={config.width}
        height={config.height}
        rx={config.rx ?? 0}
        fill={config.fill ? color : 'none'}
        stroke={stroke}
        strokeWidth={strokeWidth}
      />
    );
  });

  return (
    <View
      accessible={false}
      accessibilityElementsHidden
      importantForAccessibility="no-hide-descendants"
      style={{ width: size, height: size }}>
      <Svg width={size} height={size} viewBox="0 0 24 24">
        {children}
      </Svg>
    </View>
  );
}

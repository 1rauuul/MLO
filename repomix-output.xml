<file path="src/features/profile/model/backup.logic.ts">
export const PROGRESS_BACKUP_VERSION = 1;

export interface ProgressBackup {
  version: 1;
  exportedAt: string;
  moduleProgress: {
    lessonId: string;
    completed: boolean;
    updatedAt: string;
  }[];
  attempts: {
    source: 'practice' | 'evaluation';
    itemId: string;
    itemType: string;
    lessonId: string;
    correct: boolean;
    createdAt: string;
  }[];
  evaluationResults: {
    evaluationId: string;
    score: number;
    correctCount: number;
    totalCount: number;
    createdAt: string;
  }[];
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === 'object' && value !== null;
}

function isString(value: unknown): value is string {
  return typeof value === 'string';
}

function isBoolean(value: unknown): value is boolean {
  return typeof value === 'boolean';
}

function isNumber(value: unknown): value is number {
  return typeof value === 'number' && Number.isFinite(value);
}

export function parseProgressBackup(raw: string): ProgressBackup {
  const value: unknown = JSON.parse(raw);
  if (!isRecord(value) || value.version !== PROGRESS_BACKUP_VERSION) {
    throw new Error('Formato de respaldo no compatible.');
  }

  const moduleProgress = value.moduleProgress;
  const attempts = value.attempts;
  const evaluationResults = value.evaluationResults;
  if (
    !isString(value.exportedAt) ||
    !Array.isArray(moduleProgress) ||
    !Array.isArray(attempts) ||
    !Array.isArray(evaluationResults)
  ) {
    throw new Error('El respaldo está incompleto.');
  }

  if (
    !moduleProgress.every(
      item =>
        isRecord(item) &&
        isString(item.lessonId) &&
        isBoolean(item.completed) &&
        isString(item.updatedAt),
    )
  ) {
    throw new Error('El progreso del respaldo no es válido.');
  }

  if (
    !attempts.every(
      item =>
        isRecord(item) &&
        (item.source === 'practice' || item.source === 'evaluation') &&
        isString(item.itemId) &&
        isString(item.itemType) &&
        isString(item.lessonId) &&
        isBoolean(item.correct) &&
        isString(item.createdAt),
    )
  ) {
    throw new Error('Los intentos del respaldo no son válidos.');
  }

  if (
    !evaluationResults.every(
      item =>
        isRecord(item) &&
        isString(item.evaluationId) &&
        isNumber(item.score) &&
        isNumber(item.correctCount) &&
        isNumber(item.totalCount) &&
        isString(item.createdAt),
    )
  ) {
    throw new Error('Los resultados del respaldo no son válidos.');
  }

  return value as unknown as ProgressBackup;
}
</file>

<file path="src/features/profile/model/backupRepository.ts">
import type { SQLiteDatabase } from 'expo-sqlite';

import type { ProgressBackup } from '@/features/profile/model/backup.logic';

interface ProgressRow {
  lesson_id: string;
  completed: number;
  updated_at: string;
}

interface AttemptRow {
  source: 'practice' | 'evaluation';
  item_id: string;
  item_type: string;
  lesson_id: string;
  correct: number;
  created_at: string;
}

interface EvaluationResultRow {
  evaluation_id: string;
  score: number;
  correct_count: number;
  total_count: number;
  created_at: string;
}

export async function selectProgressBackup(db: SQLiteDatabase, accountId: number): Promise<ProgressBackup> {
  const [moduleProgress, attempts, evaluationResults] = await Promise.all([
    db.getAllAsync<ProgressRow>(
      'SELECT lesson_id, completed, updated_at FROM module_progress WHERE account_id = ? ORDER BY lesson_id',
      accountId,
    ),
    db.getAllAsync<AttemptRow>(
      'SELECT source, item_id, item_type, lesson_id, correct, created_at FROM attempts WHERE account_id = ? ORDER BY id',
      accountId,
    ),
    db.getAllAsync<EvaluationResultRow>(
      'SELECT evaluation_id, score, correct_count, total_count, created_at FROM evaluation_results WHERE account_id = ? ORDER BY id',
      accountId,
    ),
  ]);

  return {
    version: 1,
    exportedAt: new Date().toISOString(),
    moduleProgress: moduleProgress.map(row => ({
      lessonId: row.lesson_id,
      completed: row.completed === 1,
      updatedAt: row.updated_at,
    })),
    attempts: attempts.map(row => ({
      source: row.source,
      itemId: row.item_id,
      itemType: row.item_type,
      lessonId: row.lesson_id,
      correct: row.correct === 1,
      createdAt: row.created_at,
    })),
    evaluationResults: evaluationResults.map(row => ({
      evaluationId: row.evaluation_id,
      score: row.score,
      correctCount: row.correct_count,
      totalCount: row.total_count,
      createdAt: row.created_at,
    })),
  };
}

export async function replaceProgressFromBackup(
  db: SQLiteDatabase,
  accountId: number,
  backup: ProgressBackup,
): Promise<void> {
  await db.withTransactionAsync(async () => {
    await db.runAsync('DELETE FROM module_progress WHERE account_id = ?', accountId);
    await db.runAsync('DELETE FROM attempts WHERE account_id = ?', accountId);
    await db.runAsync('DELETE FROM evaluation_results WHERE account_id = ?', accountId);

    for (const progress of backup.moduleProgress) {
      await db.runAsync(
        'INSERT INTO module_progress (account_id, lesson_id, completed, updated_at) VALUES (?, ?, ?, ?)',
        accountId,
        progress.lessonId,
        progress.completed ? 1 : 0,
        progress.updatedAt,
      );
    }

    for (const attempt of backup.attempts) {
      await db.runAsync(
        'INSERT INTO attempts (account_id, source, item_id, item_type, lesson_id, correct, created_at) VALUES (?, ?, ?, ?, ?, ?, ?)',
        accountId,
        attempt.source,
        attempt.itemId,
        attempt.itemType,
        attempt.lessonId,
        attempt.correct ? 1 : 0,
        attempt.createdAt,
      );
    }

    for (const result of backup.evaluationResults) {
      await db.runAsync(
        'INSERT INTO evaluation_results (account_id, evaluation_id, score, correct_count, total_count, created_at) VALUES (?, ?, ?, ?, ?, ?)',
        accountId,
        result.evaluationId,
        result.score,
        result.correctCount,
        result.totalCount,
        result.createdAt,
      );
    }
  });
}
</file>


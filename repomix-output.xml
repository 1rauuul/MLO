<file path="src/features/exercises/viewmodel/useExerciseEngine.ts">
import { useSQLiteContext } from 'expo-sqlite';
import { useCallback, useEffect, useMemo, useRef, useState } from 'react';

import { selectExercisesByLesson } from '@/features/exercises/model/exerciseRepository';
import type { CrosswordEntry, Exercise, ExerciseConfig, MatchPair } from '@/shared/model/entities';

import {
  buildFillBank,
  crosswordCells,
  extractFillAnswers,
  isCrosswordCorrect,
  isFillCorrect,
  isMatchCorrect,
  isOrderCorrect,
  moveItem,
  reorderItem,
  scrambleOrder,
  shuffleItems,
  splitFillSentences,
  type CrosswordCell,
  type FillSegment,
} from '@/features/exercises/viewmodel/exercise.logic';
export interface ExerciseEngine {
  steps: string[];
  correctOrder: string[];
  checked: boolean;
  isCorrect: boolean;
  move: (index: number, direction: -1 | 1) => void;
  moveTo: (from: number, to: number) => void;
  submit: (onResult?: (correct: boolean) => void) => boolean;
  solve: () => void;
  reset: () => void;
}

export function useExerciseEngine(exercise: Exercise | null, initialSteps?: string[]): ExerciseEngine {
  const initialRef = useRef(initialSteps);
  const [steps, setSteps] = useState<string[]>([]);
  const [checked, setChecked] = useState(false);
  const [isCorrect, setIsCorrect] = useState(false);

  useEffect(() => {
    if (!exercise) {
      setSteps([]);
      setChecked(false);
      setIsCorrect(false);
      return;
    }
    setSteps(initialRef.current ? [...initialRef.current] : scrambleOrder(exercise.correctOrder));
    setChecked(false);
    setIsCorrect(false);
  }, [exercise]);

  const move = useCallback((index: number, direction: -1 | 1) => {
    setSteps(previous => moveItem(previous, index, direction));
    setChecked(false);
  }, []);

  const moveTo = useCallback((from: number, to: number) => {
    setSteps(previous => reorderItem(previous, from, to));
    setChecked(false);
  }, []);

  const submit = useCallback(
    (onResult?: (correct: boolean) => void) => {
      if (!exercise) {
        return false;
      }
      const correct = isOrderCorrect(steps, exercise.correctOrder);
      setIsCorrect(correct);
      setChecked(true);
      onResult?.(correct);
      return correct;
    },
    [exercise, steps],
  );

  const solve = useCallback(() => {
    if (!exercise) {
      return;
    }
    setSteps([...exercise.correctOrder]);
    setIsCorrect(true);
    setChecked(true);
  }, [exercise]);

  const reset = useCallback(() => {
    if (!exercise) {
      return;
    }
    setSteps(scrambleOrder(exercise.correctOrder));
    setChecked(false);
    setIsCorrect(false);
  }, [exercise]);

  return {
    steps,
    correctOrder: exercise?.correctOrder ?? [],
    checked,
    isCorrect,
    move,
    moveTo,
    submit,
    solve,
    reset,
  };
}

interface UseExercisesForLessonResult {
  exercises: Exercise[];
  isLoading: boolean;
}

export function useExercisesForLesson(lessonId: string | null): UseExercisesForLessonResult {
  const db = useSQLiteContext();
  const [exercises, setExercises] = useState<Exercise[]>([]);
  const [isLoading, setIsLoading] = useState(true);

  useEffect(() => {
    if (!lessonId) {
      setExercises([]);
      setIsLoading(false);
      return;
    }
    let active = true;
    setIsLoading(true);
    (async () => {
      const loaded = await selectExercisesByLesson(db, lessonId);
      if (!active) {
        return;
      }
      setExercises(loaded);
      setIsLoading(false);
    })();
    return () => {
      active = false;
    };
  }, [db, lessonId]);

  return { exercises, isLoading };
}

export interface FillEngine {
  sentences: FillSegment[][];
  answers: string[];
  ordered: string[];
  bank: string[];
  used: boolean[];
  assignment: (string | null)[];
  activeBlank: number | null;
  checked: boolean;
  isCorrect: boolean;
  selectBlank: (index: number) => void;
  placeWord: (bankIndex: number) => void;
  clearBlank: (index: number) => void;
  submit: (onResult?: (correct: boolean) => void) => boolean;
  solve: () => void;
  reset: () => void;
}

export interface FillInitial {
  ordered: string[];
  assignment: (string | null)[];
}

export function useFillEngine(exercise: Exercise | null, initial?: FillInitial): FillEngine {
  const initialRef = useRef(initial);
  const sourceSentences = useMemo(
    () => (exercise?.type === 'fill' ? (exercise.config.sentences ?? []) : []),
    [exercise],
  );
  const bankExtra = useMemo(
    () => (exercise?.type === 'fill' ? (exercise.config.bank ?? []) : []),
    [exercise],
  );
  const [ordered, setOrdered] = useState<string[]>([]);

  useEffect(() => {
    setOrdered(
      initialRef.current?.ordered ? [...initialRef.current.ordered] : shuffleItems(sourceSentences, Math.random),
    );
  }, [sourceSentences]);

  const sentences = useMemo(() => splitFillSentences(ordered), [ordered]);
  const answers = useMemo(() => extractFillAnswers(ordered), [ordered]);

  const [bank, setBank] = useState<string[]>([]);
  const [used, setUsed] = useState<boolean[]>([]);
  const [assignment, setAssignment] = useState<(string | null)[]>([]);
  const [activeBlank, setActiveBlank] = useState<number | null>(null);
  const [checked, setChecked] = useState(false);
  const [isCorrect, setIsCorrect] = useState(false);

  const reset = useCallback(() => {
    const expected = extractFillAnswers(ordered);
    const nextBank = buildFillBank(ordered, Math.random, bankExtra);
    setBank(nextBank);
    const seed = initialRef.current;
    const nextAssignment = seed?.assignment ? [...seed.assignment] : expected.map(() => null);
    const nextUsed = nextBank.map(() => false);
    nextAssignment.forEach(word => {
      if (word === null) {
        return;
      }
      const position = nextBank.findIndex((item, index) => !nextUsed[index] && item === word);
      if (position !== -1) {
        nextUsed[position] = true;
      }
    });
    setUsed(nextUsed);
    setAssignment(nextAssignment);
    setActiveBlank(null);
    setChecked(false);
    setIsCorrect(false);
  }, [ordered, bankExtra]);

  useEffect(() => {
    reset();
  }, [reset]);

  const selectBlank = useCallback((index: number) => {
    setActiveBlank(current => (current === index ? null : index));
  }, []);

  const placeWord = useCallback(
    (bankIndex: number) => {
      if (used[bankIndex]) {
        return;
      }
      const target = activeBlank ?? assignment.findIndex(item => item === null);
      if (target === -1 || assignment[target] !== null) {
        return;
      }
      const word = bank[bankIndex];
      if (word === undefined) {
        return;
      }
      const nextAssignment = [...assignment];
      nextAssignment[target] = word;
      setAssignment(nextAssignment);
      setUsed(previous => previous.map((value, index) => (index === bankIndex ? true : value)));
      const nextEmpty = nextAssignment.findIndex(item => item === null);
      setActiveBlank(nextEmpty === -1 ? null : nextEmpty);
      setChecked(false);
    },
    [activeBlank, assignment, bank, used],
  );

  const clearBlank = useCallback(
    (index: number) => {
      const word = assignment[index];
      if (word === null || word === undefined) {
        return;
      }
      setAssignment(previous => previous.map((value, position) => (position === index ? null : value)));
      setUsed(previous => {
        const bankIndex = bank.findIndex((item, position) => item === word && previous[position]);
        if (bankIndex === -1) {
          return previous;
        }
        return previous.map((value, position) => (position === bankIndex ? false : value));
      });
      setChecked(false);
    },
    [assignment, bank],
  );

  const submit = useCallback(
    (onResult?: (correct: boolean) => void) => {
      const correct = isFillCorrect(ordered, assignment);
      setChecked(true);
      setIsCorrect(correct);
      onResult?.(correct);
      return correct;
    },
    [ordered, assignment],
  );

  const solve = useCallback(() => {
    const expected = extractFillAnswers(ordered);
    const nextUsed = bank.map(() => false);
    expected.forEach(word => {
      const position = bank.findIndex((item, index) => !nextUsed[index] && item === word);
      if (position !== -1) {
        nextUsed[position] = true;
      }
    });
    setAssignment([...expected]);
    setUsed(nextUsed);
    setActiveBlank(null);
    setIsCorrect(true);
    setChecked(true);
  }, [ordered, bank]);

  return {
    sentences,
    answers,
    ordered,
    bank,
    used,
    assignment,
    activeBlank,
    checked,
    isCorrect,
    selectBlank,
    placeWord,
    clearBlank,
    submit,
    solve,
    reset,
  };
}

export interface MatchEngine {
  pairs: MatchPair[];
  lefts: string[];
  rights: string[];
  assignment: (number | null)[];
  selectedLeft: number | null;
  checked: boolean;
  isCorrect: boolean;
  selectLeft: (index: number) => void;
  selectRight: (position: number) => void;
  submit: (onResult?: (correct: boolean) => void) => boolean;
  solve: () => void;
  reset: () => void;
}

export interface MatchInitial {
  rights: string[];
  assignment: (number | null)[];
}

export function useMatchEngine(exercise: Exercise | null, initial?: MatchInitial): MatchEngine {
  const initialRef = useRef(initial);
  const pairs = useMemo(
    () => (exercise?.type === 'match' ? (exercise.config.pairs ?? []) : []),
    [exercise],
  );
  const lefts = useMemo(() => pairs.map(pair => pair.left), [pairs]);

  const [rights, setRights] = useState<string[]>([]);
  const [assignment, setAssignment] = useState<(number | null)[]>([]);
  const [selectedLeft, setSelectedLeft] = useState<number | null>(null);
  const [checked, setChecked] = useState(false);
  const [isCorrect, setIsCorrect] = useState(false);

  const reset = useCallback(() => {
    setRights(
      initialRef.current?.rights
        ? [...initialRef.current.rights]
        : shuffleItems(pairs.map(pair => pair.right), Math.random),
    );
    setAssignment(
      initialRef.current?.assignment ? [...initialRef.current.assignment] : pairs.map(() => null),
    );
    setSelectedLeft(null);
    setChecked(false);
    setIsCorrect(false);
  }, [pairs]);

  useEffect(() => {
    reset();
  }, [reset]);

  const selectLeft = useCallback((index: number) => {
    setSelectedLeft(current => (current === index ? null : index));
  }, []);

  const selectRight = useCallback(
    (position: number) => {
      if (selectedLeft === null) {
        return;
      }
      setAssignment(previous => {
        const next = [...previous];
        const owner = next.indexOf(position);
        if (owner !== -1) {
          next[owner] = null;
        }
        next[selectedLeft] = position;
        return next;
      });
      setSelectedLeft(null);
      setChecked(false);
    },
    [selectedLeft],
  );

  const submit = useCallback(
    (onResult?: (correct: boolean) => void) => {
      const correct = isMatchCorrect(pairs, rights, assignment);
      setChecked(true);
      setIsCorrect(correct);
      onResult?.(correct);
      return correct;
    },
    [pairs, rights, assignment],
  );

  const solve = useCallback(() => {
    setAssignment(pairs.map(pair => rights.indexOf(pair.right)));
    setSelectedLeft(null);
    setIsCorrect(true);
    setChecked(true);
  }, [pairs, rights]);

  return {
    pairs,
    lefts,
    rights,
    assignment,
    selectedLeft,
    checked,
    isCorrect,
    selectLeft,
    selectRight,
    submit,
    solve,
    reset,
  };
}

export interface CrosswordEngine {
  cells: CrosswordCell[];
  entries: CrosswordEntry[];
  bank: string[];
  rows: number;
  cols: number;
  letters: Record<string, string>;
  selectedEntry: number | null;
  checked: boolean;
  isCorrect: boolean;
  selectEntry: (index: number) => void;
  setLetter: (row: number, col: number, letter: string) => void;
  submit: (onResult?: (correct: boolean) => void) => boolean;
  solve: () => void;
  reset: () => void;
}

export function useCrosswordEngine(
  exercise: Exercise | null,
  initialLetters?: Record<string, string>,
): CrosswordEngine {
  const initialRef = useRef(initialLetters);
  const crossword = useMemo(
    () => (exercise?.type === 'crossword' ? exercise.config.crossword : undefined),
    [exercise],
  );
  const config: ExerciseConfig = useMemo(() => ({ crossword }), [crossword]);
  const bank = useMemo(
    () => (exercise?.type === 'crossword' ? (exercise.config.bank ?? []) : []),
    [exercise],
  );
  const cells = useMemo(() => crosswordCells(config), [config]);
  const [letters, setLetters] = useState<Record<string, string>>({});
  const [selectedEntry, setSelectedEntry] = useState<number | null>(null);
  const [checked, setChecked] = useState(false);
  const [isCorrect, setIsCorrect] = useState(false);

  const reset = useCallback(() => {
    setLetters(initialRef.current ? { ...initialRef.current } : {});
    setSelectedEntry(null);
    setChecked(false);
    setIsCorrect(false);
  }, []);

  useEffect(() => {
    reset();
  }, [reset, exercise]);

  const selectEntry = useCallback((index: number) => {
    setSelectedEntry(index);
  }, []);

  const setLetter = useCallback((row: number, col: number, letter: string) => {
    const clean = letter.replace(/[^a-zA-ZñÑ]/g, '').slice(-1).toUpperCase();
    setLetters(previous => ({ ...previous, [`${row}-${col}`]: clean }));
    setChecked(false);
  }, []);

  const submit = useCallback(
    (onResult?: (correct: boolean) => void) => {
      const correct = isCrosswordCorrect(config, letters);
      setChecked(true);
      setIsCorrect(correct);
      onResult?.(correct);
      return correct;
    },
    [config, letters],
  );

  const solve = useCallback(() => {
    const next: Record<string, string> = {};
    for (const entry of crossword?.entries ?? []) {
      const stepRow = entry.direction === 'down' ? 1 : 0;
      const stepCol = entry.direction === 'across' ? 1 : 0;
      entry.word.split('').forEach((character, offset) => {
        next[`${entry.row + stepRow * offset}-${entry.col + stepCol * offset}`] =
          character.toUpperCase();
      });
    }
    setLetters(next);
    setIsCorrect(true);
    setChecked(true);
  }, [crossword]);

  return {
    cells,
    entries: crossword?.entries ?? [],
    bank,
    rows: crossword?.rows ?? 0,
    cols: crossword?.cols ?? 0,
    letters,
    selectedEntry,
    checked,
    isCorrect,
    selectEntry,
    setLetter,
    submit,
    solve,
    reset,
  };
}
</file>

<file path="src/features/exercises/viewmodel/usePracticeEngine.ts">
import { useSQLiteContext } from 'expo-sqlite';
import { useCallback, useEffect, useMemo, useRef, useState } from 'react';

import { insertAttempt } from '@/features/exercises/model/attemptRepository';
import { selectExercisesByLesson } from '@/features/exercises/model/exerciseRepository';
import { selectExampleState } from '@/features/exercises/model/exampleStateRepository';
import type { Exercise, ExerciseType } from '@/shared/model/entities';
import { EXERCISE_TYPES } from '@/shared/model/entities';
import { L12_TOPIC_BY_ID } from '@/shared/services/content/topics';

import type { AttemptSummary } from '@/features/evaluations/viewmodel/analytics.logic';
import type { ExerciseScore } from '@/features/exercises/viewmodel/exercise.logic';
import { drawGroups } from '@/features/exercises/viewmodel/draw.logic';
import { useAuth } from '@/features/auth/viewmodel/useAuth';

export const PRACTICE_DRAW_COUNT = 10;

export type PracticePhase = 'running' | 'summary';

export interface PracticeQuestion {
  exerciseId: string;
  index: number;
  type: ExerciseType;
  correct: number;
  total: number;
}

export interface PracticeSummary extends AttemptSummary {
  byQuestion: PracticeQuestion[];
}

export interface PracticeEngine {
  items: Exercise[];
  phase: PracticePhase;
  index: number;
  total: number;
  current: Exercise | null;
  answered: boolean;
  lastCorrect: boolean | null;
  summary: PracticeSummary;
  isLoading: boolean;
  submit: (answer: string, correct: boolean, score?: ExerciseScore) => void;
  next: () => void;
}

const EMPTY_SUMMARY: PracticeSummary = {
  total: 0,
  correct: 0,
  accuracy: 1,
  byType: {},
  byQuestion: [],
};

function fractionOf(question: PracticeQuestion): number {
  return question.total === 0 ? 0 : question.correct / question.total;
}

// Califica solo la sesión dibujada: cada pregunta pesa igual y se desglosa por reactivo interno.
function summarizeSession(order: Exercise[], results: Record<string, ExerciseScore>): PracticeSummary {
  const byQuestion: PracticeQuestion[] = order.map((exercise, index) => {
    const score = results[exercise.id] ?? { correct: 0, total: 1 };
    return { exerciseId: exercise.id, index, type: exercise.type, correct: score.correct, total: score.total };
  });
  const byType: AttemptSummary['byType'] = {};
  const byTopic: AttemptSummary['byTopic'] = {};
  let points = 0;
  for (const question of byQuestion) {
    const fraction = fractionOf(question);
    points += fraction;
    const bucket = byType[question.type] ?? { total: 0, correct: 0 };
    bucket.total += 1;
    bucket.correct += fraction;
    byType[question.type] = bucket;
    const topic = L12_TOPIC_BY_ID[question.exerciseId];
    if (topic) {
      const topicBucket = byTopic[topic] ?? { total: 0, correct: 0 };
      topicBucket.total += 1;
      topicBucket.correct += fraction;
      byTopic[topic] = topicBucket;
    }
  }
  const total = byQuestion.length;
  return {
    total,
    correct: points,
    accuracy: total === 0 ? 1 : points / total,
    byType,
    byTopic,
    byQuestion,
  };
}

export function usePracticeEngine(lessonId: string | null): PracticeEngine {
  const db = useSQLiteContext();
  const { account } = useAuth();
  const [items, setItems] = useState<Exercise[]>([]);
  const [order, setOrder] = useState<Exercise[]>([]);
  const [phase, setPhase] = useState<PracticePhase>('running');
  const [index, setIndex] = useState(0);
  const [answered, setAnswered] = useState(false);
  const [lastCorrect, setLastCorrect] = useState<boolean | null>(null);
  const [results, setResults] = useState<Record<string, ExerciseScore>>({});
  const [isLoading, setIsLoading] = useState(true);
  const answeredRef = useRef(false);

  useEffect(() => {
    if (!lessonId) {
      setItems([]);
      setIsLoading(false);
      return;
    }
    let active = true;
    setIsLoading(true);
    answeredRef.current = false;
    (async () => {
      const loaded = (await selectExercisesByLesson(db, lessonId)).filter(exercise =>
        EXERCISE_TYPES.includes(exercise.type),
      );
      let exampleIds: string[] = [];
      if (account) {
        const state = await selectExampleState(db, account.id, lessonId);
        exampleIds = state.drawExampleIds;
      }
      const pool = loaded
        .filter(exercise => !exampleIds.includes(exercise.id))
        .map(exercise => exercise.id);
      const drawnIds = drawGroups([], pool, PRACTICE_DRAW_COUNT, Math.random).exerciseIds;
      const byId = new Map(loaded.map(exercise => [exercise.id, exercise]));
      const orderItems = drawnIds
        .map(id => byId.get(id))
        .filter((item): item is Exercise => Boolean(item));
      if (!active) {
        return;
      }
      setItems(loaded);
      setOrder(orderItems);
      setIndex(0);
      setAnswered(false);
      setLastCorrect(null);
      setResults({});
      setPhase('running');
      setIsLoading(false);
    })();
    return () => {
      active = false;
    };
  }, [db, lessonId, account]);

  const summary = useMemo(() => summarizeSession(order, results), [order, results]);

  const submit = useCallback(
    (answer: string, correct: boolean, score?: ExerciseScore) => {
      if (answeredRef.current) {
        return;
      }
      answeredRef.current = true;
      setAnswered(true);
      setLastCorrect(correct);
      const itemId = currentItemId(order, index);
      setResults(previous => ({
        ...previous,
        [itemId]: score ?? { correct: correct ? 1 : 0, total: 1 },
      }));
      if (account && lessonId) {
        void insertAttempt(
          db,
          account.id,
          'practice',
          itemId,
          typeAt(order, index),
          lessonId,
          correct,
        );
      }
    },
    [db, account, lessonId, order, index],
  );

  const next = useCallback(() => {
    if (index < order.length - 1) {
      setIndex(current => current + 1);
      setAnswered(false);
      setLastCorrect(null);
      answeredRef.current = false;
      return;
    }
    setPhase('summary');
  }, [index, order.length]);

  const current = order[index] ?? null;

  return {
    items,
    phase,
    index,
    total: order.length,
    current,
    answered,
    lastCorrect,
    summary,
    isLoading,
    submit,
    next,
  };
}

function currentItemId(order: Exercise[], index: number): string {
  return order[index]?.id ?? '';
}

function typeAt(order: Exercise[], index: number) {
  return order[index]?.type ?? 'order';
}
</file>


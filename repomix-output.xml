            "id": "domain-style-minimal",
            "split": "calibration",
            "mode": "domain",
            "domain": "style",
            "query": "minimal grid",
            "judgments": [{"identity": {"Style Category": "Minimalism"}, "grade": 2}],
        }
        return {
            "schemaVersion": 1,
            "globalNegativeApplicability": {"domains": ["style"], "stacks": []},
            "cases": [dict(case, id=f"case-{index}") for index in range(60)],
        }


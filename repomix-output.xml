import { Pressable, StyleSheet, View } from 'react-native';

import { useTheme } from '@/shared/theme/ThemeProvider';
import { matchScore, type ExerciseScore } from '@/features/exercises/viewmodel/exercise.logic';
import type { MatchEngine } from '@/features/exercises/viewmodel/useExerciseEngine';

import { AppText } from '@/shared/components/AppText';
import { PrimaryButton, SecondaryButton } from '@/shared/components/Buttons';
import { Icon } from '@/shared/components/Icon';
import { accentForIndex } from '@/features/exercises/view/activities/accents';

interface MatchExerciseProps {
  engine: MatchEngine;
  onSubmit: (answer: string, correct: boolean, score: ExerciseScore) => void;
  showReset?: boolean;
  locked?: boolean;
  variant?: 'default' | 'example';
  hideCheck?: boolean;
}

export function MatchExercise({
  engine,
  onSubmit,
  showReset = true,
  locked = false,
  variant = 'default',
  hideCheck = false,
}: MatchExerciseProps) {
  const { colors, radius, spacing } = useTheme();
  const example = variant === 'example';
  const complete = engine.assignment.every(item => item !== null);

  const check = () => {
    const correct = engine.submit();
    onSubmit(
      JSON.stringify(engine.assignment),
      correct,
      matchScore(engine.pairs, engine.rights, engine.assignment),
    );
  };

  const leftCorrect = (index: number): boolean => {
    const linked = engine.assignment[index];
    return linked !== null && engine.rights[linked] === engine.pairs[index]?.right;
  };

  return (
    <View>
      <AppText variant="small" style={[styles.hint, { color: colors.muted }]}>
        Toca un concepto y después la definición que le corresponde. Cada par se marca con su color.
      </AppText>

      <View style={[styles.columns, { marginTop: spacing.md }]}>
        <View style={styles.column}>
          {engine.lefts.map((left, index) => {
            const accent = accentForIndex(index);
            const selected = engine.selectedLeft === index;
            const correct = leftCorrect(index);
            return (
              <Pressable
                key={left}
                accessibilityRole="button"
                accessibilityState={{ selected, disabled: locked }}
                accessibilityLabel={`Concepto ${left}`}
                disabled={locked}
                onPress={() => engine.selectLeft(index)}
                style={[
                  styles.item,
                  {
                    backgroundColor: selected ? `${accent}1F` : colors.card,
                    borderColor: accent,
                    borderWidth: selected ? 3 : 2,
                    borderRadius: radius.control,
                  },
                ]}>
                <View style={[styles.badge, { backgroundColor: accent }]}>
                  <AppText variant="small" color={colors.onPrimary} weight="700">
                    {index + 1}
                  </AppText>
                </View>
                <AppText variant="small" weight="600" style={styles.flex}>
                  {left}
                </AppText>
                {engine.checked ? (
                  <Icon
                    name={correct ? 'check' : 'close'}
                    size={16}
                    color={correct ? colors.success : colors.danger}
                    strokeWidth={2.5}
                  />
                ) : null}
              </Pressable>
            );
          })}
        </View>

        <View style={styles.column}>
          {engine.rights.map((right, position) => {
            const owner = engine.assignment.indexOf(position);
            const accent = owner === -1 ? colors.line : accentForIndex(owner);
            const correct = owner !== -1 && leftCorrect(owner);
            return (
              <Pressable
                key={right}
                accessibilityRole="button"
                accessibilityLabel={`Definición ${right}`}
                accessibilityState={{ disabled: locked }}
                disabled={locked}
                onPress={() => engine.selectRight(position)}
                style={[
                  styles.item,
                  {
                    backgroundColor: owner === -1 ? colors.card : `${accent}14`,
                    borderColor: accent,
                    borderWidth: owner === -1 ? 1 : 2,
                    borderRadius: radius.control,
                    opacity: engine.selectedLeft === null && owner === -1 ? 0.85 : 1,
                  },
                ]}>
                <View style={[styles.badge, { backgroundColor: owner === -1 ? colors.soft : accent }]}>
                  <AppText
                    variant="small"
                    color={owner === -1 ? colors.muted : colors.onPrimary}
                    weight="700">
                    {owner === -1 ? position + 1 : owner + 1}
                  </AppText>
                </View>
                <AppText variant="small" style={styles.flex}>
                  {right}
                </AppText>
                {engine.checked && owner !== -1 ? (
                  <Icon
                    name={correct ? 'check' : 'close'}
                    size={16}
                    color={correct ? colors.success : colors.danger}
                    strokeWidth={2.5}
                  />
                ) : null}
              </Pressable>
            );
          })}
        </View>
      </View>

      {hideCheck && !showReset ? null : (
        <View style={[styles.actions, { marginTop: spacing.lg }]}>
          {hideCheck ? null : (
            <PrimaryButton
              label="Comprobar"
              disabled={locked || !complete}
              onPress={check}
              style={styles.action}
            />
          )}
          {showReset ? <SecondaryButton label="Reintentar" onPress={engine.reset} style={styles.action} /> : null}
        </View>
      )}

      {example && engine.checked ? (
        <View
          style={[
            styles.feedback,
            {
              backgroundColor: colors.card,
              borderColor: engine.isCorrect ? colors.success : colors.danger,
              borderRadius: radius.control,
            },
          ]}>
          <View style={styles.feedbackRow}>
            <Icon
              name={engine.isCorrect ? 'check' : 'refresh'}
              size={16}
              color={engine.isCorrect ? colors.success : colors.danger}
              strokeWidth={2.5}
            />
            <AppText color={engine.isCorrect ? colors.success : colors.danger} weight="700">
              {engine.isCorrect ? 'Conceptos enlazados' : 'Hay enlaces que no corresponden'}
            </AppText>
          </View>
          <AppText variant="small">
            {engine.isCorrect
              ? 'Cada concepto quedó con su definición correcta.'
              : 'Toca un concepto y elige otra definición para corregir.'}
          </AppText>
        </View>
      ) : null}
    </View>
  );
}

const styles = StyleSheet.create({
  hint: { lineHeight: 18 },
  columns: { flexDirection: 'row', gap: 10 },
  column: { flex: 1, gap: 8 },
  item: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 8,
    padding: 12,
    borderWidth: 2,
    minHeight: 52,
  },
  flex: { flex: 1 },
  badge: {
    width: 22,
    height: 22,
    borderRadius: 999,
    alignItems: 'center',
    justifyContent: 'center',
  },
  actions: { flexDirection: 'row', gap: 12 },
  action: { flex: 1 },
  feedback: { borderWidth: 1, padding: 14, gap: 4, marginTop: 14 },
  feedbackRow: { flexDirection: 'row', alignItems: 'center', gap: 8 },
});
</file>

<file path="src/features/exercises/view/QuizOption.tsx">
import { Pressable, StyleSheet, View } from 'react-native';

import { useTheme } from '@/shared/theme/ThemeProvider';

import { AppText } from '@/shared/components/AppText';
import { Icon } from '@/shared/components/Icon';

export type QuizOptionResult = 'correct' | 'wrong';

interface QuizOptionProps {
  index: number;
  label: string;
  selected: boolean;
  result?: QuizOptionResult;
  onPress: () => void;
}

export function QuizOption({ index, label, selected, result, onPress }: QuizOptionProps) {
  const { colors, radius } = useTheme();
  const letter = String.fromCharCode(65 + index);
  const borderColor =
    result === 'correct'
      ? colors.success
      : result === 'wrong'
        ? colors.danger
        : selected
          ? colors.primary
          : colors.line;

  const mark =
    result === 'correct' ? (
      <Icon name="check" size={16} color={borderColor} strokeWidth={2.5} />
    ) : result === 'wrong' ? (
      <Icon name="close" size={16} color={borderColor} strokeWidth={2.5} />
    ) : (
      <AppText variant="code" color={borderColor} weight="700">
        {letter}
      </AppText>
    );

  return (
    <Pressable
      accessibilityRole="button"
      accessibilityState={{ disabled: !!result, selected }}
      accessibilityLabel={`Opción ${letter}: ${label}${result === 'correct' ? ', correcta' : result === 'wrong' ? ', incorrecta' : ''}`}
      disabled={!!result}
      onPress={onPress}
      style={({ pressed }) => [
        styles.option,
        { borderColor, backgroundColor: colors.card, borderRadius: radius.control },
        pressed && !result ? { opacity: 0.85 } : null,
      ]}>
      <View style={[styles.letter, { backgroundColor: colors.soft }]}>{mark}</View>
      <AppText style={styles.label}>{label}</AppText>
    </Pressable>
  );
}

const styles = StyleSheet.create({
  option: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 12,
    padding: 14,
    borderWidth: 1,
  },
  letter: {
    width: 32,
    height: 32,
    borderRadius: 9,
    alignItems: 'center',
    justifyContent: 'center',
  },
  label: {
    flex: 1,
    fontSize: 14,
  },
});
</file>

<file path="src/features/exercises/viewmodel/__tests__/exercise.logic.test.ts">
import type { ExerciseConfig } from '@/shared/model/entities';
import { unit1Evaluations, unit1Exercises } from '@/shared/services/content/unit1.content';

import {
  buildFillBank,
  crosswordCells,
  crosswordScore,
  extractFillAnswers,
  fillScore,
  isCrosswordCorrect,
  isFillCorrect,
  isMatchCorrect,
  matchScore,
  moveItem,
  orderScore,
  scrambleOrder,
  shuffleItems,
  splitFillSentences,
  isOrderCorrect,
  reorderItem,
} from '@/features/exercises/viewmodel/exercise.logic';

describe('exerciseLogic', () => {
  const correct = ['a', 'b', 'c', 'd'];

  it('valida una secuencia correcta', () => {
    expect(isOrderCorrect(['a', 'b', 'c', 'd'], correct)).toBe(true);
    expect(isOrderCorrect(['b', 'a', 'c', 'd'], correct)).toBe(false);
    expect(isOrderCorrect(['a', 'b', 'c'], correct)).toBe(false);
  });

  it('puntúa el orden por cada paso en su posición', () => {
    expect(orderScore(['a', 'b', 'c', 'd'], correct)).toEqual({ correct: 4, total: 4 });
    expect(orderScore(['a', 'c', 'b', 'd'], correct)).toEqual({ correct: 2, total: 4 });
  });

  it('intercambia elementos adyacentes', () => {
    expect(moveItem(correct, 0, 1)).toEqual(['b', 'a', 'c', 'd']);
    expect(moveItem(correct, 3, -1)).toEqual(['a', 'b', 'd', 'c']);
  });

  it('no mueve fuera de los límites', () => {
    expect(moveItem(correct, 0, -1)).toBe(correct);
    expect(moveItem(correct, 3, 1)).toBe(correct);
  });

  it('reordena moviendo un elemento a otra posición', () => {
    expect(reorderItem(correct, 0, 2)).toEqual(['b', 'c', 'a', 'd']);
    expect(reorderItem(correct, 3, 0)).toEqual(['d', 'a', 'b', 'c']);
    expect(reorderItem(correct, 1, 1)).toBe(correct);
    expect(reorderItem(correct, 0, 9)).toBe(correct);
  });

  it('genera un orden inicial distinto al correcto', () => {
    const scrambled = scrambleOrder(correct);
    expect(scrambled).toHaveLength(correct.length);
    expect(scrambled).not.toEqual(correct);
    expect([...scrambled].sort()).toEqual([...correct].sort());
  });
});

describe('fill (completar conceptos)', () => {
  const sentences = [
    'El buen software debe ser {{confiable}} y utilizable.',
    'Los productos {{genéricos}} se venden en el mercado abierto.',
  ];

  it('extrae las respuestas en orden', () => {
    expect(extractFillAnswers(sentences)).toEqual(['confiable', 'genéricos']);
  });

  it('divide frases en segmentos con índices globales de espacio', () => {
    const segments = splitFillSentences(sentences);
    expect(segments).toHaveLength(2);
    expect(segments[0]).toEqual([
      { text: 'El buen software debe ser ', blank: null },
      { text: '', blank: 0 },
      { text: ' y utilizable.', blank: null },
    ]);
    expect(segments[1]?.some(segment => segment.blank === 1)).toBe(true);
  });

  it('valida una asignación correcta sin importar mayúsculas', () => {
    expect(isFillCorrect(sentences, ['Confiable', 'genéricos'])).toBe(true);
  });

  it('rechaza asignaciones incompletas o erróneas', () => {
    expect(isFillCorrect(sentences, ['confiable', null])).toBe(false);
    expect(isFillCorrect(sentences, ['confiable', 'personalizados'])).toBe(false);
  });

  it('puntúa cada espacio correcto por separado', () => {
    expect(fillScore(sentences, ['Confiable', null])).toEqual({ correct: 1, total: 2 });
  });

  it('construye un banco con las mismas palabras', () => {
    const bank = buildFillBank(sentences, () => 0.5);
    expect([...bank].sort()).toEqual(['confiable', 'genéricos']);
  });

  it('shuffleItems conserva los elementos', () => {
    const shuffled = shuffleItems(['a', 'b', 'c'], () => 0.9);
    expect([...shuffled].sort()).toEqual(['a', 'b', 'c']);
  });
});

describe('match (enlazar conceptos)', () => {
  const pairs = [
    { left: 'Mantenimiento', right: 'Evolucionar con el cambio' },
    { left: 'Eficiencia', right: 'No desperdiciar recursos' },
  ];
  const rights = ['No desperdiciar recursos', 'Evolucionar con el cambio'];

  it('valida un enlace correcto', () => {
    expect(isMatchCorrect(pairs, rights, [1, 0])).toBe(true);
  });

  it('rechaza enlaces incompletos o cruzados', () => {
    expect(isMatchCorrect(pairs, rights, [1, null])).toBe(false);
    expect(isMatchCorrect(pairs, rights, [0, 1])).toBe(false);
  });

  it('puntúa cada par enlazado por separado', () => {
    expect(matchScore(pairs, rights, [1, 1])).toEqual({ correct: 1, total: 2 });
  });
});

describe('crossword', () => {
  const config = {
    crossword: {
      rows: 3,
      cols: 3,
      entries: [
        { word: 'SOL', clue: 'astro', row: 0, col: 0, direction: 'across' as const },
        { word: 'SAL', clue: 'condimento', row: 0, col: 0, direction: 'down' as const },
      ],
    },
  };

  it('genera celdas con su solución', () => {
    const cells = crosswordCells(config);
    expect(cells).toHaveLength(5);
    expect(cells.find(cell => cell.row === 0 && cell.col === 0)?.solution).toBe('S');
    expect(cells.find(cell => cell.row === 0 && cell.col === 2)?.solution).toBe('L');
    expect(cells.find(cell => cell.row === 2 && cell.col === 0)?.solution).toBe('L');
    expect(cells.find(cell => cell.row === 0 && cell.col === 0)?.entryIndexes).toEqual([0, 1]);
  });

  it('valida letras correctas', () => {
    const letters = { '0-0': 'S', '0-1': 'O', '0-2': 'L', '1-0': 'A', '2-0': 'L' };
    expect(isCrosswordCorrect(config, letters)).toBe(true);
    expect(isCrosswordCorrect(config, { '0-0': 'X' })).toBe(false);
  });

  it('puntúa cada celda correcta por separado', () => {
    expect(crosswordScore(crosswordCells(config), { '0-0': 'S' })).toEqual({ correct: 1, total: 5 });
  });
});

describe('crossword data integrity (Unidad 1)', () => {
  const configs: ExerciseConfig[] = [
    ...unit1Exercises.map(exercise => exercise.config).filter((c): c is ExerciseConfig => !!c?.crossword),
    ...unit1Evaluations.flatMap(ev => ev.questions.map(q => q.config)).filter((c): c is ExerciseConfig => !!c?.crossword),
  ];

  it('valida que cada palabra encaje en su rejilla sin conflictos', () => {
    expect(configs.length).toBeGreaterThan(0);
    for (const config of configs) {
      const crossword = config.crossword!;
      const letters = new Map<string, string>();
      for (const entry of crossword.entries) {
        const stepRow = entry.direction === 'down' ? 1 : 0;
        const stepCol = entry.direction === 'across' ? 1 : 0;
        for (let offset = 0; offset < entry.word.length; offset += 1) {
          const row = entry.row + stepRow * offset;
          const col = entry.col + stepCol * offset;
          expect(row).toBeGreaterThanOrEqual(0);
          expect(row).toBeLessThan(crossword.rows);
          expect(col).toBeGreaterThanOrEqual(0);
          expect(col).toBeLessThan(crossword.cols);
          const key = `${row}-${col}`;
          const letter = entry.word[offset]!.toUpperCase();
          const existing = letters.get(key);
          if (existing !== undefined) {
            expect(existing).toBe(letter);
          }
          letters.set(key, letter);
        }
      }
      expect(letters.size).toBeGreaterThan(0);
    }
  });
});
</file>

<file path="src/features/exercises/viewmodel/__tests__/useExerciseEngine.test.tsx">
import { act, renderHook } from '@testing-library/react-native';

import type { Exercise } from '@/shared/model/entities';

import {
  useCrosswordEngine,
  useExerciseEngine,
  useFillEngine,
  useMatchEngine,
} from '@/features/exercises/viewmodel/useExerciseEngine';

jest.mock('expo-sqlite', () => ({
  useSQLiteContext: () => ({}),
}));

const exercise: Exercise = {
  id: 'ord',
  lessonId: 'l1.2',
  type: 'order',
  prompt: 'Ordena',
  instructions: 'Usa las flechas',
  correctOrder: ['a', 'b', 'c', 'd'],
  config: {},
  explanation: '',
};

describe('useExerciseEngine', () => {
  it('inicia con un orden mezclado distinto al correcto', () => {
    const { result } = renderHook(() => useExerciseEngine(exercise));
    expect(result.current.steps).toHaveLength(4);
    expect(result.current.steps).not.toEqual(exercise.correctOrder);
    expect([...result.current.steps].sort()).toEqual([...exercise.correctOrder].sort());
  });

  it('al comprobar marca el estado y reporta el resultado', () => {
    const { result } = renderHook(() => useExerciseEngine(exercise));

    let confirmed = true;
    act(() => {
      confirmed = result.current.submit();
    });

    expect(confirmed).toBe(false);
    expect(result.current.checked).toBe(true);
    expect(result.current.isCorrect).toBe(false);
  });

  it('permite mover elementos y reiniciar', () => {
    const { result } = renderHook(() => useExerciseEngine(exercise));
    const before = [...result.current.steps];

    act(() => {
      result.current.move(0, 1);
    });
    expect(result.current.steps).not.toEqual(before);

    act(() => {
      result.current.reset();
    });
    expect(result.current.steps).toEqual(before);
  });

  it('solve deja la secuencia correcta y marca el resultado', () => {
    const { result } = renderHook(() => useExerciseEngine(exercise));

    act(() => {
      result.current.solve();
    });

    expect(result.current.steps).toEqual(exercise.correctOrder);
    expect(result.current.checked).toBe(true);
    expect(result.current.isCorrect).toBe(true);
  });
});

const fillExercise: Exercise = {
  id: 'fill',
  lessonId: 'l1.2',
  type: 'fill',
  prompt: 'Completa',
  instructions: '',
  correctOrder: [],
  config: { sentences: ['A {{uno}} y {{dos}}.'] },
  explanation: '',
};

describe('solve de las actividades de ejemplo', () => {
  it('completar rellena las respuestas correctas y marca used', () => {
    const { result } = renderHook(() => useFillEngine(fillExercise));

    act(() => {
      result.current.solve();
    });

    expect(result.current.assignment).toEqual(['uno', 'dos']);
    expect(result.current.checked).toBe(true);
    expect(result.current.isCorrect).toBe(true);
  });

  it('enlazar asigna los pares correctos', () => {
    const matchExercise: Exercise = {
      ...fillExercise,
      id: 'match',
      type: 'match',
      config: { pairs: [{ left: 'a', right: '1' }, { left: 'b', right: '2' }] },
    };
    const { result } = renderHook(() => useMatchEngine(matchExercise));

    act(() => {
      result.current.solve();
    });

    expect(result.current.assignment).toEqual([
      result.current.rights.indexOf('1'),
      result.current.rights.indexOf('2'),
    ]);
    expect(result.current.checked).toBe(true);
    expect(result.current.isCorrect).toBe(true);
  });

  it('crucigrama escribe las letras de cada entrada', () => {
    const crosswordExercise: Exercise = {
      ...fillExercise,
      id: 'cross',
      type: 'crossword',
      config: {
        crossword: {
          rows: 1,
          cols: 2,
          entries: [{ row: 0, col: 0, direction: 'across', word: 'AB', clue: 'x' }],
        },
      },
    };
    const { result } = renderHook(() => useCrosswordEngine(crosswordExercise));

    act(() => {
      result.current.solve();
    });

    expect(result.current.letters['0-0']).toBe('A');
    expect(result.current.letters['0-1']).toBe('B');
    expect(result.current.checked).toBe(true);
    expect(result.current.isCorrect).toBe(true);
  });
});
